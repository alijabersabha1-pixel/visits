// قاعدة بيانات نظام زيارات فريق السفراء
// المرحلة 1: المستخدمون والجلسات وسجل التعديلات

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AMBASSADOR // سفير
  ADMIN // مسؤول
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique // اسم الدخول، أحرف إنجليزية صغيرة
  displayName        String // الاسم الظاهر بالعربي
  role               Role      @default(AMBASSADOR)
  passwordHash       String
  active             Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  // نخزّن بصمة SHA-256 للتوكن فقط، فتسريب الجدول ما بيسمح بانتحال جلسة
  tokenHash  String   @unique
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@map("sessions")
}

// جدول إلحاق فقط: ممنوع UPDATE وDELETE بمحفّز على مستوى قاعدة البيانات (شوف الـ migration)
model AuditLog {
  id       BigInt   @id @default(autoincrement())
  at       DateTime @default(now())
  actorId  String?  @db.Uuid // null = النظام (سكربت أو نقل بيانات)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action   String // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | ...
  entity   String // User, Visit, ...
  entityId String
  field    String? // null للعمليات على الكيان كامل
  oldValue String?
  newValue String?
  note     String? // سبب أو تفاصيل إضافية

  @@index([at])
  @@index([actorId, at])
  @@index([entity, entityId])
  @@map("audit_log")
}
