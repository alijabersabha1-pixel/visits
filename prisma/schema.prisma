// قاعدة بيانات نظام زيارات فريق السفراء
// المرحلة 1: المستخدمون والجلسات وسجل التعديلات

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AMBASSADOR // سفير: بيعمل كل شي
  MANAGER // مسؤول: بيشوف كل شي للقراءة بس
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique // اسم الدخول، أحرف إنجليزية صغيرة
  displayName        String // الاسم الظاهر بالعربي
  role               Role      @default(AMBASSADOR)
  passwordHash       String
  active             Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]

  visits          Visit[]               @relation("owner")
  postponements   RevisitPostponement[]
  vpnCases        VpnCase[]
  cardPurchases   CardPurchase[]
  mikrotikReveals MikrotikReveal[]
  editRequests    EditRequest[]         @relation("requester")
  decidedRequests EditRequest[]         @relation("decider")

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  // نخزّن بصمة SHA-256 للتوكن فقط، فتسريب الجدول ما بيسمح بانتحال جلسة
  tokenHash  String   @unique
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@map("sessions")
}

// جدول إلحاق فقط: ممنوع UPDATE وDELETE بمحفّز على مستوى قاعدة البيانات (شوف الـ migration)
model AuditLog {
  id       BigInt   @id @default(autoincrement())
  at       DateTime @default(now())
  actorId  String?  @db.Uuid // null = النظام (سكربت أو نقل بيانات)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action   String // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | ...
  entity   String // User, Visit, ...
  entityId String
  field    String? // null للعمليات على الكيان كامل
  oldValue String?
  newValue String?
  note     String? // سبب أو تفاصيل إضافية

  @@index([at])
  @@index([actorId, at])
  @@index([entity, entityId])
  @@map("audit_log")
}

// ───────────── المرحلة 2: البيانات ─────────────

/// خط مشترك. المفتاح هو الكود بعد التنظيف (lib/line-code.ts)
model Line {
  id             String   @id @default(uuid()) @db.Uuid
  codeKey        String   @unique // G7872002
  code           String // G-7872-002 متل ما إجا بالملف
  accountKey     String // G7872: لخطوط نفس الحساب
  accountName    String?
  speed          String?
  locality       String?
  region         String? // غزة | الوسطى | الجنوب | null = مش معروفة
  accountManager String? // من ملف المسؤول، للقراءة
  fixedIp        String?
  addrLocality   String?
  addrQuarter    String?
  manual         Boolean  @default(false) // انضاف يدوياً (حساب طارئ)
  inLatestFile   Boolean  @default(true) // false = مش موجود بآخر ملف شهر
  lastImportId   String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  targets    MonthTarget[]
  managerLog ManagerLogEntry[]
  visits     Visit[]

  @@index([accountKey])
  @@map("lines")
}

enum ListKind {
  RECOMMENDATION // التوصية
  ACTION // الإجراء المطبق
}

/// قوائم بيعدّلها السفراء. القيمة بتوقف وما بتنمسح، عشان الزيارات القديمة تضل سليمة
model ListItem {
  id        String   @id @default(uuid()) @db.Uuid
  kind      ListKind
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  color     String? // لون الدبوس على الخريطة (للتوصيات)
  createdAt DateTime @default(now())

  recommendationVisits Visit[] @relation("recommendation")
  actionVisits         Visit[] @relation("action")

  @@unique([kind, label])
  @@map("list_items")
}

/// كل رفعة لملف الشهر
model Import {
  id           String   @id @default(uuid()) @db.Uuid
  month        String // 2026-11
  fileName     String
  fileSha256   String
  importedById String   @db.Uuid
  stats        Json
  createdAt    DateTime @default(now())

  @@index([month])
  @@map("imports")
}

/// «زيارات الشهر» من ملف المسؤول: الخطوط المطلوب زيارتها هالشهر
model MonthTarget {
  id        String   @id @default(uuid()) @db.Uuid
  month     String
  lineId    String   @db.Uuid
  line      Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  sheet     String // اسم الورقة بالملف
  region    String?
  teamNote  String? // «ملاحظات الفريق» متل ما إجت
  excluded  Boolean  @default(false) // من ورقة «استثناء من الزيارات»
  metrics   Json? // Data Speed, Utilization Avg, Total Out...
  importId  String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([month, lineId])
  @@index([month, region])
  @@map("month_targets")
}

/// سجل الإدارة من ورقة «الزيارات الإجماليه»: توصية السفراء والإجراء النهائي لمدير المنطقة. للقراءة بس
model ManagerLogEntry {
  id             String    @id @default(uuid()) @db.Uuid
  rowKey         String    @unique // الكود + التاريخ + الترتيب: الملف تراكمي، فبنحدّث ما بنكرر
  lineId         String    @db.Uuid
  line           Line      @relation(fields: [lineId], references: [id], onDelete: Cascade)
  visitDate      DateTime? @db.Date
  teamNote       String?
  recommendation String?
  finalAction    String?
  accountManager String?
  lastImportId   String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([lineId])
  @@map("manager_log")
}

enum VisitSource {
  LEGACY // منقولة من الإكسل
  APP // انسجلت بالنظام
}

/// زيارة ميدانية. بالمرحلة 2 بس الزيارات القديمة المنقولة، والتسجيل من النظام بالمرحلة 3
model Visit {
  id               String      @id @default(uuid()) @db.Uuid
  number           Int // رقم الزيارة. القديمة بأرقام الإكسل (فيها تكرار)، والجديدة بتكمل بعدها
  source           VisitSource
  legacyKey        String?     @unique // مفتاح عدم التكرار للنقل
  visitedOn        DateTime?   @db.Date
  dateText         String? // التاريخ متل ما كان بالإكسل
  dateDoubtful     Boolean     @default(false)
  lineId           String?     @db.Uuid
  line             Line?       @relation(fields: [lineId], references: [id])
  lineCode         String? // الكود متل ما انكتب
  lineCodeKey      String? // للبحث حتى لو الخط مش بملف المشتركين
  accountName      String?
  specialCase      Boolean     @default(false) // زيارة بدون Line Code
  ownerId          String?     @db.Uuid // null = قديمة بدون صاحب
  owner            User?       @relation("owner", fields: [ownerId], references: [id], onDelete: Restrict)
  companionIds     String[]    @default([]) @db.Uuid // المرافقين
  place            String? // مكان الحالة الخاصة
  tests            String? // الفحوصات اللي تمت
  result           String? // نتيجة الفحوصات
  recommendationId String?     @db.Uuid
  recommendation   ListItem?   @relation("recommendation", fields: [recommendationId], references: [id])
  actionId         String?     @db.Uuid
  action           ListItem?   @relation("action", fields: [actionId], references: [id])
  revisitNote      String? // خانة «إعادة الزيارة» بالإكسل
  revisitDue       DateTime?   @db.Date // موعد مقترح لإعادة الزيارة (اختياري)
  clientUuid       String?     @unique @db.Uuid // رقم فريد من الجوال (عدم التكرار)
  filledAt         DateTime? // وقت التعبئة بالميدان (مش وقت الإرسال)
  lat              Float?
  lng              Float?
  gpsAccuracy      Float? // بالمتر
  mikrotik         Json? // [{ questionId, question, answer }]
  revisitOfId      String?     @db.Uuid // الزيارة الأصلية اللي هاي إعادة إلها
  revisitOf        Visit?      @relation("revisit", fields: [revisitOfId], references: [id], onDelete: SetNull)
  revisits         Visit[]     @relation("revisit")
  postponements    RevisitPostponement[]
  editRequests     EditRequest[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  @@index([lineCodeKey])
  @@index([visitedOn])
  @@index([ownerId])
  @@index([recommendationId])
  @@index([number])
  @@map("visits")
}

/// إعدادات بسيطة (مثلاً خريطة أعمدة ملف الشهر المحفوظة)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// تأجيل إعادة زيارة، مع السبب
model RevisitPostponement {
  id        String   @id @default(uuid()) @db.Uuid
  visitId   String   @db.Uuid
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  reason    String
  byId      String   @db.Uuid
  by        User     @relation(fields: [byId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([visitId])
  @@map("revisit_postponements")
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// طلب تعديل تقرير زيارة سفير تاني. صاحب الزيارة بيوافق أو بيرفض
model EditRequest {
  id          String            @id @default(uuid()) @db.Uuid
  visitId     String            @db.Uuid
  visit       Visit             @relation(fields: [visitId], references: [id], onDelete: Cascade)
  requesterId String            @db.Uuid
  requester   User              @relation("requester", fields: [requesterId], references: [id], onDelete: Restrict)
  changes     Json // { field: { from, to } }
  reason      String
  status      EditRequestStatus @default(PENDING)
  decidedById String?           @db.Uuid
  decidedBy   User?             @relation("decider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())

  @@index([visitId])
  @@index([status])
  @@map("edit_requests")
}

/// صورة مرفقة (زيارة أو بطاقة). الملف برّا مجلد الموقع وبينخدم بعد فحص الدخول
model Attachment {
  id          String   @id @default(uuid()) @db.Uuid
  entity      String // Visit | Card
  entityId    String   @db.Uuid
  mime        String
  size        Int
  path        String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@map("attachments")
}

model MikrotikQuestion {
  id        String   @id @default(uuid()) @db.Uuid
  text      String
  options   String[]
  role      String? // COUNT | ACCESS | USER_CREATED
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("mikrotik_questions")
}

/// بيانات دخول مايكروتيك خط. كلمة السر مشفّرة (lib/crypto.ts)
model MikrotikCredential {
  id             String   @id @default(uuid()) @db.Uuid
  lineCodeKey    String   @unique
  username       String
  passwordCipher String
  updatedById    String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("mikrotik_credentials")
}

/// سجل عرض كلمات السر (للإلحاق فقط، للسفراء بس)
model MikrotikReveal {
  id           BigInt   @id @default(autoincrement())
  credentialId String   @db.Uuid
  lineCodeKey  String
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  at           DateTime @default(now())

  @@index([at])
  @@map("mikrotik_reveals")
}

model VpnCase {
  id          String    @id @default(uuid()) @db.Uuid
  clientUuid  String?   @unique @db.Uuid
  filledAt    DateTime
  ownerId     String    @db.Uuid
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  networkName String
  ip          String
  lat         Float?
  lng         Float?
  gpsAccuracy Float?
  placeText   String?
  suspects    String?
  notes       String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([ip])
  @@map("vpn_cases")
}

enum CardLink {
  VISIT
  EXTERNAL
  VPN
  NONE
}

model CardPurchase {
  id         String    @id @default(uuid()) @db.Uuid
  clientUuid String?   @unique @db.Uuid
  filledAt   DateTime
  ownerId    String    @db.Uuid
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name       String
  ip         String?
  price      Decimal   @db.Decimal(10, 2)
  linkKind   CardLink  @default(NONE)
  linkRef    String?   @db.Uuid // رقم الزيارة أو حالة VPN (أو رقمها من الجوال)
  lat        Float?
  lng        Float?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([filledAt])
  @@map("card_purchases")
}
