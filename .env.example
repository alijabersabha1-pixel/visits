# انسخ هالملف لـ .env وعدّل القيم

# كلمتين سر قاعدة البيانات (Docker بس). كل وحدة طويلة وعشوائية:  openssl rand -base64 24
# DB_PASSWORD: مالك الجداول (للتحديثات والأدوات) · APP_DB_PASSWORD: مستخدم الموقع (صلاحيات أقل)
DB_PASSWORD=""
APP_DB_PASSWORD=""

DATABASE_URL="postgresql://visits:visits@localhost:5432/visits"

# عنوان الموقع الكامل، بيستخدم لفحص مصدر الطلبات (CSRF)
APP_ORIGIN="http://localhost:3000"

# كوكي آمنة (Secure). خليها true على أي سيرفر عليه HTTPS
COOKIE_SECURE="false"

# مفتاح تشفير كلمات سر المايكروتيك (32 بايت). ولّده مرة وحدة بـ:  openssl rand -base64 32
# ⚠️ إذا ضاع المفتاح، كلمات السر المحفوظة ما بتنفك. احفظ نسخة منه برّا السيرفر.
MIKROTIK_KEY=""

# مجلد الصور (برّا مجلد الموقع). على Docker بينضبط لحاله
UPLOAD_DIR="./data/uploads"

# ملف الـ APK (اختياري، شوف docs/install-android.md)
TWA_PACKAGE_NAME=""
TWA_SHA256_FINGERPRINTS=""

# إذا الموقع ورا بروكسي أو موازن حِمل بالشركة: true، عشان تحديد معدل الدخول يكون لكل عنوان
TRUST_PROXY="false"

# النسخ الاحتياطي (docs/deploy.md). ⚠️ احفظ كلمة السر برّا السيرفر: بدونها النسخ ما بتنفك
BACKUP_PASSPHRASE=""
BACKUP_KEEP="30"
# مجلد النسخ على السيرفر (الأفضل قرص تاني أو مجلد شبكة)
BACKUP_HOST_DIR="./backups"
