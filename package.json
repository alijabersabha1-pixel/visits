{
  "name": "ambassadors-visits",
  "version": "0.1.0",
  "private": true,
  "description": "نظام زيارات فريق السفراء — جوال",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
