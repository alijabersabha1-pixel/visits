    "test:coverage": "vitest run --coverage",
    "create-user": "tsx scripts/create-user.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "security:check": "node scripts/security-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "leaflet": "1.9",
    "leaflet.markercluster": "1.5",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "playwright-core": "^1.56.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
